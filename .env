# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_MODEL=deepseek-v3.1:671b-cloud

# ── AI Models ─────────────────────────────────────────────────────────────────
QWEN_MODEL=qwen3-coder:480b-cloud
DEEPSEEK_MODEL=deepseek-v3.2:cloud

# ── GitHub token (for GPT-4o via Azure Inference) ─────────────────────────────
# Set this on the server: export GITHUB_TOKEN=your_token_here
GITHUB_TOKEN=

# ── Web service ───────────────────────────────────────────────────────────────
FRONTEND_PORT=3020

# Optional: protect the generate endpoint with a token (leave empty to disable)
# MANIMAX_GENERATE_TOKEN=mysecrettoken

# ── Concurrency limits ────────────────────────────────────────────────────────
MANIMAX_MAX_CONCURRENT_GENERATIONS=2
MANIMAX_MIN_GENERATE_INTERVAL_MS=8000
