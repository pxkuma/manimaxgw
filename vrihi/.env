# ─── Vrihi AI Configuration ──────────────────────────────────────────────────

# Primary model — best for code generation on your setup
OLLAMA_MODEL=deepseek-v3.2:cloud

# Models used by auto_video.py pipeline stages
# QWEN_MODEL: Manim code generation (draft). Set to a local model if cloud is unavailable.
QWEN_MODEL=qwen3-coder:480b-cloud
# DEEPSEEK_MODEL: Manim code refinement (refine pass). HTTP 403 means the cloud
# model is not authorised via your Ollama instance — swap to a local model below.
DEEPSEEK_MODEL=deepseek-v3.2:cloud
# Example local fallback (uncomment if deepseek-v3.2:cloud keeps returning 403):
# DEEPSEEK_MODEL=deepseek-coder-v2:16b

# Fallback chain — if primary fails, tries these in order
MANIMAX_AI_FALLBACK_MODELS=deepseek-v3.1:671b-cloud,qwen3-coder:480b-cloud

# Ollama endpoint
OLLAMA_URL=http://host.docker.internal:11434/api/generate

# ─── Timeouts (cloud-routed so be generous) ───────────────────────────────────
MANIMAX_AI_TIMEOUT_NARRATION=180
MANIMAX_AI_TIMEOUT_PLAN=240
MANIMAX_AI_MAX_RETRIES=2
MANIMAX_AI_RETRY_DELAY_SECONDS=3.0
MANIMAX_AI_TIMEOUT_BACKOFF_SECONDS=30

# ─── Video Settings ───────────────────────────────────────────────────────────
MANIMAX_TARGET_DURATION=45
MANIMAX_NUM_CHAPTERS=3
MANIMAX_RENDER_QUALITY=high
MANIMAX_TARGET_FPS=60
MANIMAX_ALLOW_LOW_QUALITY_FALLBACK=1
MANIMAX_SYNC_TOLERANCE=0.2

# ─── TTS Settings ─────────────────────────────────────────────────────────────
MANIMAX_TTS_VOICE=en-GB-RyanNeural
MANIMAX_TTS_VOICE_FALLBACKS=en-US-AriaNeural,en-US-GuyNeural,en-GB-SoniaNeural
MANIMAX_TTS_RATE=-5%
MANIMAX_TTS_MAX_RETRIES=2

# ─── Scene Timing ─────────────────────────────────────────────────────────────
MANIMAX_MIN_SCENE_SECONDS=4.0
MANIMAX_MAX_STATIC_HOLD_SECONDS=8.0

# ─── Optional: Background music ───────────────────────────────────────────────
# Drop a bg.mp3 next to auto_video.py and it gets mixed in at 6% volume
# (leave this commented if you don't have one)
# BG_MUSIC=bg.mp3

GITHUB_TOKEN=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

